# --- Rust Specific ---
# The target directory contains all build artifacts (binaries, dependencies, docs)
/target/

# --- Cargo Lock ---
# For BINARY projects, you SHOULD commit Cargo.lock to ensure reproducible builds.
# For LIBRARY projects, it is often ignored. 
# Since this project has binaries (client/server), keep it committed.
# Only uncomment the line below if you decide to make this a pure library.
# Cargo.lock

# --- Backup/Temporary Files ---
# Generated by editors or the OS
**/*.rs.bk
*.swp
*.swo
.DS_Store
Thumbs.db

# --- IDEs/Editors ---
# Visual Studio Code
.vscode/
# IntelliJ/PyCharm/CLion
.idea/

# --- Environment/Secrets & Local DBs ---
# If you eventually add a .env file for database credentials or API keys
.env
.env.*
*.key
*.db
*.db-journal

# --- Debug/Profiling ---
# If you use 'cargo kcov' or other coverage tools
/cobertura.xml
/debug/